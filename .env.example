# Variables de entorno del Prototipo: AQUÍ SOLO VAN LOS NOMBRES. Copia este archivo a .env.local y escribe tus propios valores (nunca se versionan).
# Todos los datos y cuentas son ficticios.

# Secreto con el que se firma la cookie de sesión (mínimo 16 caracteres, aleatorio).
RUPE_SESION_SECRETO=

# Cuentas ficticias con credencial (el correo es opcional: si falta se usa el del seed). Sin contraseña, la cuenta existe pero no puede iniciar sesión.
RUPE_ADMIN_CORREO=
RUPE_ADMIN_CONTRASENA=
RUPE_TUTOR1_CORREO=
RUPE_TUTOR1_CONTRASENA=
RUPE_TUTOR2_CORREO=
RUPE_TUTOR2_CONTRASENA=

# Reinicio de los datos ficticios (POST /api/dev/reiniciar): en producción solo existe con el valor 1 y exige sesión de Administrador.
RUPE_PERMITIR_REINICIO=
